# =========================
# Project Specific
# =========================
# Ignore the raw MongoDB volume bind mount
mongo-data/

# Ignore the ZIP archives you uploaded during development
*.zip

# Note: db-backup/ is purposefully omitted so your JSON exports get tracked by Git

# =========================
# Node.js / React (Frontend)
# =========================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =========================
# Gradle / Java (Backend Microservices)
# =========================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Explicitly ignore build outputs in microservice directories
apigateway/build/
problemmanagement/build/
execution/build/

# Ignore compiled class files and binaries
bin/
out/
*.class
*.log

# =========================
# Python (Execution Runner)
# =========================
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/

# =========================
# IDEs and Editors
# =========================
# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# =========================
# OS Generated Files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
